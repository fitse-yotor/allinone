---
import {getCopy,localizePath,type Locale} from '../i18n/utils';
interface Props {locale:Locale;}
const {locale}=Astro.props;
const t=getCopy(locale);
const path=(value:string)=>localizePath(value,locale);
---
<footer class="company-footer on-navy">
 <div class="page footer-columns">
  <div class="footer-about"><a class="footer-brand" href={path('/')}>{t.company.name}</a><p>Connected technology.<br/>Ethiopian roots. Wider possibilities.</p><a class="footer-conversation" href={path('/contact/')}>Let’s build something together ↗</a></div>
  <nav aria-label="Footer services"><h2>Expertise</h2><a href={path('/cybersecurity/')}>Cybersecurity</a><a href={path('/infrastructure/')}>Infrastructure</a><a href={path('/development/')}>Development</a><a href={path('/industries/')}>Industries</a></nav>
  <nav aria-label="Footer company"><h2>Company</h2><a href={path('/about/')}>About us</a><a href={path('/team/')}>Our team</a><a href={path('/projects/')}>Projects</a><a href={path('/testimonials/')}>Testimonials</a><a href={path('/approach/')}>Our approach</a></nav>
  <div class="footer-contact"><h2>Visit & connect</h2><a href={t.company.phoneHref}>+251 912 602 101</a><a href={path('/contact/')}>Send an enquiry ↗</a><address><strong>Office location</strong><br/>Bole, Addis Ababa, Ethiopia<br/><small>Sample location · exact address to be confirmed</small></address></div>
 </div>
 <div class="page footer-bottom"><span>© {new Date().getFullYear()} {t.company.name}. All rights reserved.</span><a href={path('/')}>Back to home ↑</a><span>Designed for a connected future.</span></div>
</footer>
