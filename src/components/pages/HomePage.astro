---
import Base from '../../layouts/Base.astro';
import EngineeringScene from '../EngineeringScene.astro';
import Showcase from '../Showcase.astro';
import {getCopy, localizePath, type Locale} from '../../i18n/utils';
interface Props {locale: Locale;}
const {locale}=Astro.props;
const t=getCopy(locale); const am=locale==='am';
const path=(p:string)=>localizePath(p,locale);
const partners=['BUNNA EXPORT','selam health','ABAY FINANCE','Entoto Labs','Sheger Logistics'];
---
<Base title={t.home.title} description={t.home.description} isHome>
<section class="landing-hero"><div class="page hero-layout"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span>{am?'በኢትዮጵያ የተገነባ። ለወደፊቱ የተዘጋጀ።':'ROOTED IN ETHIOPIA. BUILT FOR WHAT’S NEXT.'}</p><h1>{am?'ቴክኖሎጂ ከዓላማ ጋር።':'Technology.'}<br/><em>{am?'በአንድነት እንገንባ።':'Beautifully connected.'}</em></h1><p class="hero-description">{am?t.home.hero.body:'Secure systems. Dependable infrastructure. Thoughtful software. We bring it all together, so your organisation can move forward with confidence.'}</p><div class="hero-actions"><a class="action" href={path('/contact/')}>{am?'እንነጋገር':'Let’s build together'} <span>↗</span></a><a class="text-link" href={path('/projects/')}>{am?'ፕሮጀክቶቻችን':'Explore our work'} <span>↗</span></a></div><div class="hero-bottom"><span class="little-mark">a<span>o</span></span><p>One partner. Every layer.<br/><strong>Addis Ababa, Ethiopia</strong></p></div></div><EngineeringScene /></div></section>
<section class="partners-band"><div class="page partners-heading"><span class="eyebrow">A shared vision. A stronger ecosystem.</span><span class="sample-note">Illustrative partner companies</span><button class="motion-toggle" aria-pressed="false">Pause motion</button></div><div class="partner-window"><div class="partner-track">{[0,1].map((copy)=><div class="partner-set" aria-hidden={copy===1?'true':undefined}>{partners.map((name)=><span><b>✳</b> {name}</span>)}</div>)}</div></div></section>
<section class="landing-section page" id="services"><div class="section-heading"><div><p class="eyebrow">01 / WHAT WE DO</p><h2>Every part of your technology.<br/><em>Working as one.</em></h2></div><p>From the foundation to the experience, we connect the expertise your organisation needs.</p></div><div class="services-grid">{t.home.practices.items.map((p,i)=><a class="service-card" href={path(p.path)}><div class="service-top"><span class="service-icon">{['◈','⌘','〈/〉'][i]}</span><span>0{i+1} ↗</span></div><h3>{p.name}</h3><p>{p.tagline} {p.body.split('. ')[0]}.</p><span class="service-more">Explore service ↗</span></a>)}</div></section>
<section class="work-section"><div class="page landing-section"><div class="section-heading"><div><p class="eyebrow">02 / SELECTED POSSIBILITIES</p><h2>Local understanding.<br/><em>Meaningful outcomes.</em></h2></div><a class="text-link" href={path('/projects/')}>All projects ↗</a></div><Showcase kind="projects"/><p class="sample-note section-note">Sample projects for demonstration. These do not represent completed client engagements.</p></div></section>
<section class="landing-section page"><div class="section-heading"><div><p class="eyebrow">03 / PEOPLE, BEFORE TECHNOLOGY</p><h2>Good work starts<br/><em>with good people.</em></h2></div><a class="text-link" href={path('/team/')}>Meet the team ↗</a></div><Showcase kind="team" limit={4}/><p class="sample-note section-note">AI-generated portraits with fictional team profiles and masked Ethiopian phone numbers.</p></section>
<section class="testimonials-section"><div class="landing-section page"><div class="section-heading"><div><p class="eyebrow">04 / WORDS THAT MATTER</p><h2>Built on connection.<br/><em>Remembered for care.</em></h2></div><a class="text-link" href={path('/testimonials/')}>More perspectives ↗</a></div><Showcase kind="testimonials"/><p class="sample-note section-note">Sample testimonials, with fictional names and companies, for layout preview.</p></div></section>
<section class="page"><div class="closing-cta"><div><p class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</p><h2>Let’s make technology<br/>work for you.</h2></div><div><a class="action" href={path('/contact/')}>Start a conversation ↗</a><p><a href={t.company.phoneHref}>+251 912 602 101</a> · Addis Ababa</p></div></div></section>
</Base>
<script>
const button=document.querySelector<HTMLButtonElement>('.motion-toggle');
button?.addEventListener('click',()=>{const paused=button.getAttribute('aria-pressed')!=='true';button.setAttribute('aria-pressed',String(paused));button.textContent=paused?'Resume motion':'Pause motion';document.documentElement.classList.toggle('motion-paused',paused);document.dispatchEvent(new CustomEvent('motion-toggle',{detail:paused}));});
</script>