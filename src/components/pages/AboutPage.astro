---
import Base from '../../layouts/Base.astro';
import ContactBand from '../ContactBand.astro';
import { getCopy, localizePath, type Locale } from '../../i18n/utils';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const t = getCopy(locale);
const a = t.about;
const am = locale === 'am';
const path = (value: string) => localizePath(value, locale);
const practices = t.home.practices.items;
---

<Base title={a.title} description={a.description}>
  <section class="about-hero">
    <div class="page about-hero__grid">
      <div class="about-hero__copy motion-target">
        <p class="label">{a.label} / All In One Cyber Security solution</p>
        <h1>{am ? a.heading : 'One team for every technology layer.'}</h1>
        <p class="about-hero__lede">{a.intro[0]}</p>
        <p class="about-hero__body">{a.intro[2]}</p>
        <div class="about-hero__actions">
          <a class="action" href={path('/contact/')}>{am ? 'እንነጋገር' : 'Work with us'} <span>↗</span></a>
          <a class="text-link" href={path('/approach/')}>{am ? 'የስራ ሂደታችን' : 'How we work'} <span>↗</span></a>
        </div>
      </div>

      <div class="brand-stage motion-target" aria-label="All In One Cyber Security solution — secure, connect, build">
        <span class="brand-stage__ring brand-stage__ring--one"></span>
        <span class="brand-stage__ring brand-stage__ring--two"></span>
        <div class="brand-stage__logo"><img src="/all-in-one-cyber-security-logo.png" alt="All In One Cyber Security solution" width="1255" height="1255" /></div>
        <span class="brand-stage__tag brand-stage__tag--one">SECURE</span>
        <span class="brand-stage__tag brand-stage__tag--two">CONNECT</span>
        <span class="brand-stage__tag brand-stage__tag--three">BUILD</span>
        <p>{am ? 'አንድ ቡድን። አንድ ኃላፊነት።' : 'One team. One accountable system.'}</p>
      </div>
    </div>
  </section>

  <section class="section section--deep" aria-labelledby="practices-heading">
    <div class="page about-practices">
      <div class="about-practices__head motion-target">
        <p class="label">{am ? 'የተቀናጀ ችሎታ' : 'Integrated capability'}</p>
        <h2 id="practices-heading">{am ? 'ሶስት የስራ ዘርፎች። አንድ ውጤት።' : 'Three practices. One outcome.'}</h2>
        <p class="soft">{a.intro[1]}</p>
      </div>
      <div class="practice-grid">
        {practices.map((practice, i) => (
          <a class="practice-card motion-target" href={path(practice.path)}>
            <span class="practice-card__number">0{i + 1}</span>
            <span class="practice-card__arrow">↗</span>
            <h3>{practice.name}</h3>
            <p>{practice.tagline}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--navy on-navy" aria-label={`${a.missionLabel}, ${a.visionLabel}`}>
    <div class="page purpose">
      <div class="purpose__item motion-target"><h2 class="label">{a.missionLabel}</h2><p>{a.mission}</p></div>
      <div class="purpose__item motion-target"><h2 class="label">{a.visionLabel}</h2><p>{a.vision}</p></div>
    </div>
  </section>

  <section class="section" aria-labelledby="values-heading">
    <div class="page values-layout">
      <div class="values-intro motion-target"><p class="label">{a.valuesLabel}</p><h2 id="values-heading">{am ? 'ስራችንን የሚመሩ መርሆዎች።' : 'Principles that guide the work.'}</h2><p class="soft">{a.valuesNote}</p></div>
      <dl class="values">
        {a.values.map((value, i) => (
          <div class="values__item motion-target"><dt><span>0{i + 1}</span>{value.name}</dt><dd>{value.text}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <ContactBand locale={locale} />
</Base>

<style>
  .about-hero { position: relative; overflow: hidden; padding-block: clamp(4rem, 8vw, 8rem); }
  .about-hero::before { content: ''; position: absolute; width: 28rem; height: 28rem; right: -10rem; top: -12rem; border: 1px solid var(--c-rule); border-radius: 50%; }
  .about-hero__grid { display: grid; gap: var(--space-8); align-items: center; }
  .about-hero__copy { max-width: 48rem; }
  .about-hero h1 { max-width: 12ch; margin-top: var(--space-5); font-size: clamp(3.2rem, 6vw, 6.5rem); line-height: .98; }
  .about-hero__lede { max-width: 42rem; margin-top: var(--space-6); font-size: var(--t-2); line-height: 1.5; }
  .about-hero__body { max-width: 39rem; margin-top: var(--space-4); color: var(--c-ink-soft); }
  .about-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-6); margin-top: var(--space-6); }
  .brand-stage { position: relative; isolation: isolate; min-height: 35rem; display: grid; place-items: center; overflow: hidden; border-radius: 22px; background: var(--c-navy); color: var(--c-on-navy); box-shadow: 0 32px 80px #173d3424; }
  .brand-stage::before { content: ''; position: absolute; inset: 10%; border: 1px solid #ffffff24; border-radius: 50%; }
  .brand-stage__ring { position: absolute; border: 1px solid #d8e6d534; border-radius: 50%; animation: orbit-turn 22s linear infinite; }
  .brand-stage__ring::after { content: ''; position: absolute; width: .65rem; height: .65rem; top: 50%; right: -.35rem; border-radius: 50%; background: #b7d699; box-shadow: 0 0 22px #b7d699; }
  .brand-stage__ring--one { width: 78%; height: 48%; transform: rotate(-18deg); }
  .brand-stage__ring--two { width: 55%; height: 72%; transform: rotate(34deg); animation-direction: reverse; animation-duration: 28s; }
  .brand-stage__logo { position: relative; z-index: 2; display: grid; place-items: center; width: min(19rem, 55%); aspect-ratio: 1; border-radius: 50%; background: white; box-shadow: 0 20px 60px #0005; animation: brand-float 6s ease-in-out infinite; }
  .brand-stage__logo img { width: 88%; height: 88%; object-fit: contain; border-radius: 50%; }
  .brand-stage__tag { position: absolute; z-index: 3; padding: .55rem .8rem; border: 1px solid #ffffff38; border-radius: 999px; background: #173d34e8; font: .72rem var(--font-mono); letter-spacing: .1em; }
  .brand-stage__tag--one { top: 17%; left: 9%; }
  .brand-stage__tag--two { right: 8%; top: 35%; }
  .brand-stage__tag--three { left: 15%; bottom: 20%; }
  .brand-stage > p { position: absolute; z-index: 3; bottom: var(--space-5); font-size: .82rem; color: var(--c-on-navy-soft); }
  .about-practices { display: grid; gap: var(--space-8); }
  .about-practices__head { max-width: 50rem; }
  .about-practices__head h2, .values-intro h2 { margin-top: var(--space-4); font-size: clamp(2.4rem, 4vw, 4.5rem); }
  .about-practices__head .soft, .values-intro .soft { margin-top: var(--space-5); max-width: 43rem; }
  .practice-grid { display: grid; gap: var(--space-4); }
  .practice-card { position: relative; min-height: 15rem; padding: var(--space-6); border: 1px solid var(--c-rule-strong); border-radius: 12px; background: var(--c-paper); color: var(--c-ink); text-decoration: none; transition: transform .28s ease, box-shadow .28s ease, background .28s ease; }
  .practice-card:hover { transform: translateY(-6px); background: white; box-shadow: 0 22px 45px #173d3414; }
  .practice-card__number { color: var(--c-accent); font: var(--t--1) var(--font-mono); }
  .practice-card__arrow { position: absolute; top: var(--space-5); right: var(--space-5); }
  .practice-card h3 { margin-top: var(--space-8); font-size: var(--t-2); }
  .practice-card p { margin-top: var(--space-3); color: var(--c-ink-soft); }
  .purpose { display: grid; gap: var(--space-8); }
  .purpose__item { padding-top: var(--space-5); border-top: 1px solid var(--c-on-navy-soft); }
  .purpose__item p { margin-top: var(--space-4); max-width: 36ch; font-size: var(--t-3); line-height: 1.35; }
  .values-layout { display: grid; gap: var(--space-8); }
  .values { display: grid; margin: 0; border-top: 1px solid var(--c-rule-strong); }
  .values__item { padding-block: var(--space-5); border-bottom: 1px solid var(--c-rule); }
  .values__item dt { display: flex; gap: var(--space-4); font-size: var(--t-1); font-weight: var(--w-semibold); }
  .values__item dt span { color: var(--c-accent); font: var(--t--1) var(--font-mono); }
  .values__item dd { margin: var(--space-2) 0 0 calc(var(--space-4) + 1.5rem); max-width: 38rem; color: var(--c-ink-soft); }
  @keyframes brand-float { 50% { transform: translateY(-10px); } }
  @keyframes orbit-turn { to { rotate: 360deg; } }

  @media (min-width: 62rem) {
    .about-hero__grid { grid-template-columns: minmax(0, 1fr) minmax(32rem, .82fr); column-gap: clamp(4rem, 7vw, 8rem); }
    .about-practices { grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); }
    .practice-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .purpose { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-9); }
    .values-layout { grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); column-gap: var(--space-9); }
    .values { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); }
  }
  @media (max-width: 40rem) { .brand-stage { min-height: 26rem; } .brand-stage__logo { width: 54%; } }
  @media (prefers-reduced-motion: reduce) { .brand-stage__ring, .brand-stage__logo { animation: none; } .practice-card { transition: none; } }
</style>
