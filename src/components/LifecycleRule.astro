---
interface Props {
  steps: string[];
}

const { steps } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class="cycle" style={`--cycle-count: ${steps.length}`}>
  {
    steps.map((step, i) => (
      <li class="cycle__step">
        <span class="cycle__num numeral">{pad(i + 1)}</span>
        <span class="cycle__name">{step}</span>
      </li>
    ))
  }
</ol>

<style>
  .cycle {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule-hair) solid var(--c-ink);
  }

  .cycle__step {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--rule-hair) solid var(--c-rule);
  }

  .cycle__num { font-size: var(--t--1); }

  .cycle__name {
    font-size: var(--t-2);
    font-weight: var(--w-medium);
    line-height: var(--lh-tight);
  }

  /* Desktop: one ruled horizontal sequence. Each step carries a short accent
     tick on the top rule, so the order reads left to right without arrows. */
  @media (min-width: 62rem) {
    .cycle {
      grid-template-columns: repeat(var(--cycle-count, 6), minmax(0, 1fr));
      border-bottom: var(--rule-hair) solid var(--c-rule);
    }

    .cycle__step {
      position: relative;
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-5) var(--space-4) var(--space-5) 0;
      border-bottom: 0;
    }

    .cycle__step + .cycle__step {
      padding-left: var(--space-4);
      border-left: var(--rule-hair) solid var(--c-rule);
    }

    .cycle__step::before {
      content: '';
      position: absolute;
      top: calc(var(--rule-hair) * -1);
      left: 0;
      width: var(--space-6);
      height: var(--space-1);
      background: var(--c-accent);
    }
  }
</style>
